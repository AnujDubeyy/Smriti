# A separate Smriti Supabase project is required. Never reuse Cybrion's project.
SMRITI_SUPABASE_URL=
SMRITI_SUPABASE_PUBLISHABLE_KEY=
SMRITI_SUPABASE_PROJECT_REF=
# Exact origin, allowlisted in Supabase Auth redirect settings.
SMRITI_APP_URL=http://localhost:3000
# Do not place service-role or secret keys in the browser or this repository.

# Speech and AI: auto uses live providers only when both keys are present.
# Use only synthetic data with the free Gemini tier.
GNANI_API_KEY_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GNANI_DEFAULT_VOICE_ID=Shivani
VOICE_PROVIDER=auto

# Optional free-tier alternative. Keys remain server-side.
GROQ_API_KEY=
LLM_PROVIDER=gemini
STT_PROVIDER=gnani
GROQ_MODEL=openai/gpt-oss-120b
# Set both providers to groq after adding the Groq key.
